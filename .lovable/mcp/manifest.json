{
  "version": 1,
  "sdk_version": "0.24.0",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://lelteebbziredzfamkzb.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "mfm-paisagismo-mcp",
      "version": "0.1.0",
      "title": "MFM Paisagismo"
    },
    "tools": [
      {
        "name": "whoami",
        "title": "Quem sou eu",
        "description": "Retorna informações do usuário autenticado (id, email, nome, papéis).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_clientes",
        "title": "Listar clientes",
        "description": "Lista clientes visíveis ao usuário autenticado, com busca opcional por nome, cidade ou CPF/CNPJ. Respeita as permissões (RLS) do usuário.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "busca": {
              "description": "Termo de busca (nome, cidade, CPF/CNPJ).",
              "type": "string"
            },
            "status": {
              "description": "Filtrar por status (ex.: 'ativo', 'inativo').",
              "type": "string"
            },
            "limite": {
              "description": "Máximo de resultados (padrão 25).",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_cliente",
        "title": "Detalhes do cliente",
        "description": "Retorna dados detalhados de um cliente pelo id, incluindo projetos vinculados.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "cliente_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "UUID do cliente."
            }
          },
          "required": [
            "cliente_id"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_projetos",
        "title": "Listar projetos",
        "description": "Lista projetos visíveis ao usuário (respeita alocação e RLS). Filtre por status, tipo ou cliente.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "status": {
              "description": "Ex.: 'em_andamento', 'concluido'.",
              "type": "string"
            },
            "tipo": {
              "description": "Ex.: 'implantacao', 'manutencao'.",
              "type": "string"
            },
            "cliente_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "busca": {
              "description": "Busca por título.",
              "type": "string"
            },
            "limite": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_crm_cards",
        "title": "Listar cards do CRM",
        "description": "Lista cards do funil de CRM (leads, propostas, aprovados, em execução, etc). Respeita RLS do usuário.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "status": {
              "description": "Ex.: 'Lead', 'Proposta Enviada', 'Aprovado', 'Em Execucao', 'Concluido', 'Pos-venda', 'Nao Aprovado'.",
              "type": "string"
            },
            "cliente_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "busca": {
              "description": "Busca por título ou nome do contato.",
              "type": "string"
            },
            "limite": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "create_crm_card",
        "title": "Criar card no CRM",
        "description": "Cria um novo card (lead) no funil de CRM. O card é criado com o usuário autenticado como responsável quando não indicado.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "titulo": {
              "type": "string",
              "minLength": 1,
              "description": "Título do card (obrigatório)."
            },
            "tipo": {
              "type": "string",
              "minLength": 1,
              "description": "Tipo do card (ex.: 'Implantação', 'Manutenção')."
            },
            "status": {
              "description": "Status inicial (padrão 'Lead').",
              "type": "string"
            },
            "cliente_id": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "projeto_id": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "contato_nome": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "contato_email": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "contato_whatsapp": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "observacoes": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "prazo": {
              "description": "Data em ISO (YYYY-MM-DD).",
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "titulo",
            "tipo"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "describe_schema",
        "title": "Descrever schema",
        "description": "Introspecção só-leitura do schema public. Sem parâmetro, lista todas as tabelas com contagem de colunas e status de RLS. Com 'tabela', devolve colunas, chave primária, chaves estrangeiras e status de RLS. Nunca lê dados.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "tabela": {
              "description": "Nome da tabela do schema public. Omita para listar todas.",
              "type": "string"
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "read_table",
        "title": "Ler tabela",
        "description": "Leitura genérica de qualquer tabela do schema public, respeitando as permissões (RLS) do usuário autenticado. Só retorna o que o usuário tem permissão para ver.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "tabela": {
              "type": "string",
              "minLength": 1,
              "description": "Nome da tabela do schema public."
            },
            "colunas": {
              "description": "Lista de colunas separadas por vírgula (padrão '*').",
              "type": "string"
            },
            "filtros": {
              "description": "Objeto campo→valor para igualdade estrita.",
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "ordenar_por": {
              "description": "Coluna para ordenar. Prefixe com '-' para descendente (ex.: '-created_at').",
              "type": "string"
            },
            "limite": {
              "description": "Padrão 25, máximo 100.",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "offset": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "tabela"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_storage",
        "title": "Listar Storage",
        "description": "Lista buckets ou arquivos do Storage. Sem parâmetro, devolve buckets (nome, público/privado). Com 'bucket' (e 'prefixo' opcional), lista arquivos (nome, tamanho, criado em), máximo 100. Não devolve conteúdo nem URLs assinadas.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "bucket": {
              "description": "Nome do bucket.",
              "type": "string"
            },
            "prefixo": {
              "description": "Prefixo (pasta) dentro do bucket.",
              "type": "string"
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "criar_registros",
        "title": "Criar registros em lote",
        "description": "Cria linhas em lote em tabelas de cadastro (whitelist). Roda deduplicação para plantas, insumos e fornecedores (match_catalogo/norm_catalogo com nome). Match >= 0.90 é reportado como possível duplicado e NÃO cria (a menos que forcar=true). Máx 50 linhas por chamada. Escreve com o token do usuário (RLS ativa).",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "tabela": {
              "type": "string",
              "enum": [
                "clientes",
                "locais_cliente",
                "colaboradores",
                "maquinas",
                "insumos",
                "insumo_unidades",
                "plantas",
                "fornecedores",
                "fornecedor_atendentes",
                "estoque_movimentacoes"
              ],
              "description": "Tabela alvo. Aceita apenas: clientes, locais_cliente, colaboradores, maquinas, insumos, insumo_unidades, plantas, fornecedores, fornecedor_atendentes, estoque_movimentacoes"
            },
            "linhas": {
              "minItems": 1,
              "maxItems": 50,
              "type": "array",
              "items": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              },
              "description": "Array de objetos (máx 50)."
            },
            "forcar": {
              "description": "Se true, cria mesmo quando houver possível duplicado.",
              "type": "boolean"
            }
          },
          "required": [
            "tabela",
            "linhas"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "atualizar_registro",
        "title": "Atualizar registro por id",
        "description": "Atualiza UMA linha por id em tabelas de cadastro (whitelist). Em 'projetos' só permite corrigir tipo, status, titulo, responsavel_id e datas (data_inicio, data_fim, data_previsao, data_conclusao). Escreve com o token do usuário (RLS ativa). Retorna antes → depois.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "tabela": {
              "type": "string",
              "enum": [
                "clientes",
                "locais_cliente",
                "colaboradores",
                "maquinas",
                "insumos",
                "insumo_unidades",
                "plantas",
                "fornecedores",
                "fornecedor_atendentes",
                "estoque_movimentacoes",
                "projetos"
              ],
              "description": "Tabela alvo. Aceita: clientes, locais_cliente, colaboradores, maquinas, insumos, insumo_unidades, plantas, fornecedores, fornecedor_atendentes, estoque_movimentacoes, projetos"
            },
            "id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "UUID da linha."
            },
            "campos": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {},
              "description": "Campos a atualizar (objeto). Não passe id."
            }
          },
          "required": [
            "tabela",
            "id",
            "campos"
          ]
        },
        "outputSchema": null
      }
    ]
  }
}
